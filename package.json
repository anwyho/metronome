{
  "name": "metronome-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An offline-first PWA template, with a metronome as its reference app.",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "tsc -p tsconfig.json",
    "build": "npm run clean && (npm run compile || true) && node tools/copy-static.mjs && node tools/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "vendor": "node tools/vendor.mjs",
    "site": "bash tools/build-site.sh",
    "serve": "npm run build && node dist/tools/serve.js",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "prettier": "^3.6.2",
    "puppeteer": "^24.15.0",
    "typescript": "^7.0.2"
  }
}
